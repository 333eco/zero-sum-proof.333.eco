// The zero-sum proof's statement (ledger.heartbank.net design/signed-proof.md, Part 2). Generated by gen.py: edit main.nr.tmpl, never main.nr.
//
// One proof covers K consecutive entries of the public log. For each entry it either changes nothing (padding, a public entry, or a row
// this proof does not count) or proves that the entry is a thank row, signed by a passkey with the user verified, moving exactly its
// rule's units from one account to another, counted once. The balances live in private trees committed to by C; every proof moves C on.
// The sum of every balance in each ledger and season stays zero because every step adds +u and -u.
use std::hash::sha256_compression;
use std::hash::poseidon2_permutation;

global K: u32 = @K@;
global SEASONS: u32 = 8;
global MSG_MAX: u32 = 390;
global MSG_PAD: u32 = 448;
global CD_MAX: u32 = 320;
global CD_PAD: u32 = 384;
global OFFSET: Field = 1099511627776; // 2^40: a balance stays inside (-2^40, 2^40)
global IV: [u32; 8] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
global SAFE: [bool; 256] = @SAFE@;
global B64: [bool; 256] = @B64@;
global ALPH: [u8; 64] = @ALPH@;
global RP_HASH: [u8; 32] = @RP@;

pub struct Acct { bal: Field, salt: Field, fresh: bool, sibs: [Field; 64] }

pub struct Slot {
    enabled: bool,
    // the row, as sealed: "ledger/seal/v1\0" then its JCS bytes
    msg: [u8; MSG_MAX], msg_len: u32, app_len: u32, dir: u8, kind: u8, ledger: u8, season_digits: u32, units_digits: u32,
    // the press
    x: [u8; 32], y: [u8; 32], sig: [u8; 64], auth: [u8; 37], cd: [u8; CD_MAX], cd_len: u32,
    // what the press covered besides the row
    role: u8, other_type: u8, other_id: [u8; 32], other_r: [u8; 32],
    // the trees
    signer: Acct, other: Acct, spent: [Field; 128],
}

fn perm(a: Field, b: Field, c: Field, d: Field) -> Field { let o: [Field; 4] = poseidon2_permutation([a, b, c, d]); o[0] }
fn hash2(l: Field, r: Field) -> Field { perm(l, r, 0, 2) }
fn acct_leaf(key: Field, bal: Field, salt: Field) -> Field { perm(key, bal, salt, 3) }
fn spent_leaf(key: Field) -> Field { perm(key, 1, 0, 4) }
fn commitment(a: Field, s: Field, blind: Field) -> Field { perm(a, s, blind, 5) }
fn acct_key(kind: Field, season: Field, ledger: Field, a: Field, b: Field, c: Field, d: Field) -> Field {
    perm(perm(kind * 4294967296 * 256 + season * 256 + ledger, a, b, 6), c, d, 7)
}

fn pack<let N: u32, let S: u32, let C: u32>(b: [u8; N]) -> Field {
    let mut v: Field = 0;
    for i in 0..C { v = v * 256 + b[S + i] as Field; }
    v
}

// ⛔ The path comes from the canonical low 128 bits of the key, so one key has exactly one place in a tree.
fn path_bits(key: Field) -> [bool; 128] {
    let (lo, _hi) = std::field::bn254::decompose(key);
    lo.to_le_bits()
}
fn root_at<let D: u32>(leaf: Field, key: Field, sibs: [Field; D]) -> Field {
    let bits = path_bits(key);
    let mut node = leaf;
    for i in 0..D { node = if bits[i] { hash2(sibs[i], node) } else { hash2(node, sibs[i]) }; }
    node
}

// ── SHA-256 ──
fn words<let P: u32>(p: [u8; P], b: u32) -> [u32; 16] {
    let mut w = [0u32; 16];
    for i in 0..16 {
        let o = b * 64 + i * 4;
        w[i] = ((p[o] as u32) << 24) | ((p[o + 1] as u32) << 16) | ((p[o + 2] as u32) << 8) | (p[o + 3] as u32);
    }
    w
}
fn bytes_of(st: [u32; 8]) -> [u8; 32] {
    let mut out = [0u8; 32];
    for i in 0..8 { out[4 * i] = (st[i] >> 24) as u8; out[4 * i + 1] = (st[i] >> 16) as u8; out[4 * i + 2] = (st[i] >> 8) as u8; out[4 * i + 3] = st[i] as u8; }
    out
}
fn sha_fixed<let L: u32, let P: u32>(m: [u8; L]) -> [u8; 32] {
    let mut p = [0u8; P];
    for i in 0..L { p[i] = m[i]; }
    p[L] = 0x80;
    let bits = (L as u64) * 8;
    for k in 0..8 { p[P - 1 - k] = (bits >> (8 * k as u64)) as u8; }
    let mut st = IV;
    for b in 0..(P / 64) { st = sha256_compression(words(p, b), st); }
    bytes_of(st)
}
// A message of witness length `len` inside an array of M: every byte past `len` is ignored, and the padding is constrained.
fn sha_var<let M: u32, let P: u32>(m: [u8; M], len: u32) -> [u8; 32] {
    assert(len + 9 <= P);
    let nb = (len + 72) / 64;
    let end = nb * 64;
    let bits = (len as u64) * 8;
    let mut lb = [0u8; 8];
    for k in 0..8 { lb[k] = (bits >> (8 * (7 - k) as u64)) as u8; }
    let mut p = [0u8; P];
    for i in 0..P {
        let mut v: u8 = 0;
        if i < M { if i < len { v = m[i]; } }
        if i == len { v = 0x80; }
        if (i + 8 >= end) & (i < end) { v = lb[i + 8 - end]; }
        p[i] = v;
    }
    let mut st = IV;
    let mut out = IV;
    for b in 0..(P / 64) {
        st = sha256_compression(words(p, b), st);
        if b + 1 == nb { out = st; }
    }
    bytes_of(out)
}

// ── reading the row ──
fn expect<let N: u32, let M: u32>(m: [u8; M], pos: u32, s: [u8; N]) { for i in 0..N { assert(m[pos + i] == s[i]); } }
fn safe_run<let M: u32, let MAXN: u32>(m: [u8; M], pos: u32, n: u32) { for i in 0..MAXN { if i < n { assert(SAFE[m[pos + i] as u32]); } } }
fn b64_run<let M: u32>(m: [u8; M], pos: u32) { for i in 0..43 { assert(B64[m[pos + i] as u32]); } }
fn number<let M: u32, let MAXD: u32>(m: [u8; M], pos: u32, d: u32) -> u32 {
    assert((d >= 1) & (d <= MAXD));
    if d > 1 { assert(m[pos] != 48); } // no leading zero
    let mut v: u32 = 0;
    for i in 0..MAXD {
        if i < d { let c = m[pos + i]; assert((c >= 48) & (c <= 57)); v = v * 10 + (c - 48) as u32; }
    }
    v
}

pub struct Row { season: u32, units: u32, salt: [u8; 43] }

// ⛔ Every free field is from a charset with no quote, so the row has exactly one reading.
fn read_row(m: [u8; MSG_MAX], len: u32, app_len: u32, dir: u8, kind: u8, ledger: u8, sd: u32, ud: u32) -> Row {
    expect(m, 0, @seal_tag@);
    let mut pos: u32 = @seal_tag_N@;
    expect(m, pos, @app@); pos += @app_N@;
    assert((app_len >= 1) & (app_len <= 32));
    safe_run::<MSG_MAX, 32>(m, pos, app_len); pos += app_len;
    expect(m, pos, @at@); pos += @at_N@;
    safe_run::<MSG_MAX, 17>(m, pos, 17); pos += 17;
    expect(m, pos, @cargo@); pos += @cargo_N@;
    b64_run(m, pos); pos += 43;
    if dir != 0 {
        expect(m, pos, @dir@); pos += @dir_N@;
        if dir == 1 { expect(m, pos, @w_kind@); pos += @w_kind_N@; } else { assert(dir == 2); expect(m, pos, @w_thankful@); pos += @w_thankful_N@; }
    }
    expect(m, pos, @from@); pos += @from_N@;
    b64_run(m, pos); pos += 43;
    if kind != 0 {
        expect(m, pos, @kind@); pos += @kind_N@;
        if kind == 1 { expect(m, pos, @w_thing@); pos += @w_thing_N@; }
        else if kind == 2 { expect(m, pos, @w_plant@); pos += @w_plant_N@; }
        else { assert(kind == 3); expect(m, pos, @w_animal@); pos += @w_animal_N@; }
    }
    expect(m, pos, @ledger@); pos += @ledger_N@;
    if ledger == 1 { expect(m, pos, @w_kiitos@); } else { assert(ledger == 2); expect(m, pos, @w_kiitti@); }
    pos += 6;
    expect(m, pos, @salt@); pos += @salt_N@;
    b64_run(m, pos);
    let mut salt = [0u8; 43];
    for i in 0..43 { salt[i] = m[pos + i]; }
    pos += 43;
    expect(m, pos, @season@); pos += @season_N@;
    let season = number::<MSG_MAX, 4>(m, pos, sd); pos += sd;
    expect(m, pos, @to@); pos += @to_N@;
    b64_run(m, pos); pos += 43;
    expect(m, pos, @units@); pos += @units_N@;
    let units = number::<MSG_MAX, 5>(m, pos, ud); pos += ud;
    expect(m, pos, @v@); pos += @v_N@;
    assert(pos == len);
    Row { season, units, salt }
}

fn be4(v: u32) -> [u8; 4] { [(v >> 24) as u8, (v >> 16) as u8, (v >> 8) as u8, v as u8] }

fn update(root: Field, key: Field, a: Acct, delta: Field) -> Field {
    let mut old: Field = 0;
    if a.fresh { assert(a.bal == 0); } else { old = acct_leaf(key, a.bal, a.salt); }
    assert(root_at(old, key, a.sibs) == root);
    let bal = a.bal + delta;
    (bal + OFFSET).assert_max_bit_size::<41>();
    root_at(acct_leaf(key, bal, a.salt), key, a.sibs)
}

fn slot(t: Slot, a: Field, s: Field, origin: [u8; 32], rules: [[u32; 2]; SEASONS], seal_pub: [u8; 32]) -> (Field, Field) {
    let mut a2 = a;
    let mut s2 = s;
    if t.enabled {
        let row = read_row(t.msg, t.msg_len, t.app_len, t.dir, t.kind, t.ledger, t.season_digits, t.units_digits);
        // this entry of the public log is this row
        assert(sha_var::<MSG_MAX, MSG_PAD>(t.msg, t.msg_len) == seal_pub);
        // who signs, and which side the other account stands on
        if t.ledger == 1 { assert((t.dir == 0) & (t.kind == 0) & (t.role == 1) & (t.other_type == 1)); }
        else { assert((t.dir != 0) & (t.kind != 0) & (t.other_type == 2)); assert(t.role == (if t.dir == 1 { 2 } else { 1 })); }
        // the rule's size, and nothing else
        assert(row.season < SEASONS);
        assert(row.units == rules[row.season][(t.ledger - 1) as u32]);
        // the challenge the person's passkey signed
        let mut op = [0u8; 81];
        for i in 0..16 { op[i] = @other_tag@[i]; }
        op[16] = t.other_type;
        for i in 0..32 { op[17 + i] = t.other_id[i]; op[49 + i] = t.other_r[i]; }
        let other = sha_fixed::<81, 128>(op);
        let mut cp = [0u8; 122];
        let sb = be4(row.season); let ub = be4(row.units);
        for i in 0..16 { cp[i] = @press_tag@[i]; }
        for i in 0..32 { cp[16 + i] = origin[i]; cp[52 + i] = seal_pub[i]; cp[89 + i] = other[i]; }
        for i in 0..4 { cp[48 + i] = sb[i]; cp[85 + i] = ub[i]; }
        cp[84] = t.ledger;
        cp[121] = t.role;
        let challenge = sha_fixed::<122, 192>(cp);
        // the client data names that challenge, on the passkey site's own page
        assert((t.cd_len >= @cd_prefix_N@ + 43 + @cd_origin_N@) & (t.cd_len <= CD_MAX));
        expect(t.cd, 0, @cd_prefix@);
        let mut bits = [false; 258];
        for i in 0..32 { let b: [bool; 8] = (challenge[i] as Field).to_be_bits(); for j in 0..8 { bits[i * 8 + j] = b[j]; } }
        for k in 0..43 {
            let v = (bits[6 * k] as u32) * 32 + (bits[6 * k + 1] as u32) * 16 + (bits[6 * k + 2] as u32) * 8 + (bits[6 * k + 3] as u32) * 4 + (bits[6 * k + 4] as u32) * 2 + (bits[6 * k + 5] as u32);
            assert(t.cd[@cd_prefix_N@ + k] == ALPH[v]);
        }
        expect(t.cd, @cd_prefix_N@ + 43, @cd_origin@);
        // the passkey's site, user present and user verified
        for i in 0..32 { assert(t.auth[i] == RP_HASH[i]); }
        assert((t.auth[32] & 5) == 5);
        let cdh = sha_var::<CD_MAX, CD_PAD>(t.cd, t.cd_len);
        let mut sm = [0u8; 69];
        for i in 0..37 { sm[i] = t.auth[i]; }
        for i in 0..32 { sm[37 + i] = cdh[i]; }
        assert(std::ecdsa_secp256r1::verify_signature(t.x, t.y, t.sig, sha_fixed::<69, 128>(sm)));
        // the signer's own key account moves; the other account moves the opposite way
        let season = row.season as Field;
        let ledger = t.ledger as Field;
        let u = row.units as Field;
        let delta = if t.role == 1 { 0 - u } else { u };
        let sk = acct_key(1, season, ledger, pack::<32, 0, 16>(t.x), pack::<32, 16, 16>(t.x), pack::<32, 0, 16>(t.y), pack::<32, 16, 16>(t.y));
        let ok = acct_key((t.other_type + 1) as Field, season, ledger, pack::<32, 0, 16>(t.other_id), pack::<32, 16, 16>(t.other_id), 0, 0);
        a2 = update(a2, sk, t.signer, delta);
        a2 = update(a2, ok, t.other, 0 - delta);
        // counted once: the row's private salt names it, and nobody can enumerate salts from the public log
        let nk = perm(pack::<43, 0, 21>(row.salt), pack::<43, 21, 22>(row.salt), 0, 8);
        assert(root_at(0, nk, t.spent) == s2);
        s2 = root_at(spent_leaf(nk), nk, t.spent);
    }
    (a2, s2)
}

fn main(c_old: pub Field, c_new: pub Field, origin: pub [u8; 32], rules: pub [[u32; 2]; SEASONS], seals: pub [[u8; 32]; K],
        acct_root: Field, spent_root: Field, blind_old: Field, blind_new: Field, slots: [Slot; K]) {
    assert(commitment(acct_root, spent_root, blind_old) == c_old);
    let mut a = acct_root;
    let mut s = spent_root;
    for i in 0..K {
        let (a2, s2) = slot(slots[i], a, s, origin, rules, seals[i]);
        a = a2;
        s = s2;
    }
    assert(commitment(a, s, blind_new) == c_new);
}
